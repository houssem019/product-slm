# Copy to .env. Everything defaults to the free, offline path (fake provider, cassette replay).
LLM_PROVIDER=fake            # anthropic | ollama | fake
# ANTHROPIC_API_KEY=sk-ant-...  # only for --provider anthropic and pslm.distill.batch
TEACHER_MODEL=claude-opus-5-5   # claude-haiku-5-5 is ~40x cheaper for bulk labeling
LLM_EFFORT=low
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434
